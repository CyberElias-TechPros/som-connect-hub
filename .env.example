# SOM CONNECT — Environment Variables
# Copy to .env.local for local dev (never commit .env.local)

# ---------------------------------------------------------------------------
# API
# ---------------------------------------------------------------------------
# Leave EMPTY (or unset) to use the same-origin `/api` path — this is the
# recommended setup: `npm run dev` proxies /api to the local Worker on :8787
# and production serves the frontend and the Worker from the same domain.
#
# Set an absolute URL only when the API lives on a different host:
# VITE_API_URL=https://api.som-connect.workers.dev
VITE_API_URL=
VITE_ENV=development

# Where `vite dev` proxies /api during local development (default :8787).
# VITE_DEV_API_TARGET=http://127.0.0.1:8787

# ---------------------------------------------------------------------------
# Cloudflare (Worker side — set with `wrangler secret put`, not in the app)
# ---------------------------------------------------------------------------
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_D1_DATABASE_ID=
# CLOUDFLARE_R2_BUCKET=
# CLOUDFLARE_KV_NAMESPACE_ID=
# JWT_SECRET=<32+ random chars>
# R2_PUBLIC_BASE_URL=https://cdn.som-connect.example.com

# Payments (Stripe example for production)
# VITE_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Analytics
# VITE_POSTHOG_KEY=
# VITE_POSTHOG_HOST=https://app.posthog.com

# Feature flags
VITE_ENABLE_OFFLINE=true
VITE_ENABLE_NOTIFICATIONS=true
VITE_HAPPY_PATH=true
