{
  "name": "som-connect-worker",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --local --persist",
    "deploy": "wrangler deploy",
    "db:create": "wrangler d1 create som-connect-db",
    "db:migrate": "wrangler d1 execute som-connect-db --file=./src/db/schema.sql",
    "db:seed": "wrangler d1 execute som-connect-db --file=./src/db/seed.sql",
    "db:migrate:local": "wrangler d1 execute som-connect-db --file=./src/db/schema.sql --local",
    "db:seed:local": "wrangler d1 execute som-connect-db --file=./src/db/seed.sql --local",
    "db:reset:local": "npm run db:migrate:local && npm run db:seed:local",
    "typegen": "wrangler types",
    "test": "vitest"
  },
  "dependencies": {
    "hono": "^4.6.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241127.0",
    "wrangler": "^3.78.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  }
}
